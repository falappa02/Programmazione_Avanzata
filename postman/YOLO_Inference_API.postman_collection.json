									"const status = res.data ? res.data.status : null;",
									"",
									"pm.test(\"Stato del job valido (PENDING, RUNNING o COMPLETED)\", function () {",
									"    pm.expect(['PENDING', 'RUNNING', 'COMPLETED', 'FAILED']).to.include(status);",
